# syntax=docker/dockerfile:1
#
# Image for a project created with `uv init --package`.
# Copy this file as `Dockerfile` and `.dockerignore` next to pyproject.toml.
# Build context = project root (pyproject.toml, uv.lock, README.md, src/).
#
#   docker build -t my-job:0.1.0 .
#
# Layer strategy: dependencies (from uv.lock) and own code live in separate
# layers. A code change only rebuilds and pushes the last layer (a few KB).

FROM python:3.12-slim
# Python version must match requires-python in pyproject.toml

# - venv outside the source tree, built on the image's own Python
# - uv itself is only mounted during build, never part of the image
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"

# Layer 1: third-party dependencies.
# Rebuilt only when pyproject.toml or uv.lock change.
RUN --mount=from=ghcr.io/astral-sh/uv:0.13.0,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=/build/pyproject.toml \
    --mount=type=bind,source=uv.lock,target=/build/uv.lock \
    cd /build && uv sync --locked --no-dev --no-install-project

# Layer 2: own code, installed non-editable into the venv.
# The only layer a code change touches.
RUN --mount=from=ghcr.io/astral-sh/uv:0.13.0,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=.,target=/build,rw \
    cd /build && uv sync --locked --no-dev --no-editable

# Non-root with a fixed UID (restricted PSS)
USER 10001

# Entry point from [project.scripts] in pyproject.toml
CMD ["my-job"]
