<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM for JVM Spark jobs.

  Purpose: single place for all shared dependency versions, aligned with the
  cluster runtime pinned in this repo (see AGENTS.md and
  iceberg/argo/maintenance-workflow.yaml). Job modules inherit from this and
  declare only job-specific extras, never versions.

  Rules encoded here:
    1. Everything the cluster already provides is scope "provided"
       (Spark, Iceberg runtime) and never ends up in the job jar.
    2. One AWS SDK BOM governs every software.amazon.awssdk:* version,
       pinned to exactly the version Iceberg is built against
       (gradle/libs.versions.toml in the Iceberg repo for the release tag).
    3. No AWS SDK v1, no fat bundles, no hadoop-aws — enforced at build time.
       Use Iceberg S3FileIO with s3:// paths instead of s3a://.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.lakehouse</groupId>
  <artifactId>spark-jobs-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <!-- collects the jar set baked into the Spark runner image -->
    <module>runner-image</module>
    <!-- one module per job, e.g.: -->
    <!-- <module>jobs/example-etl</module> -->
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spark 4.0 requires Java 17+; matches apache/spark:4.0.3-python3 (Java 17) -->
    <maven.compiler.release>17</maven.compiler.release>

    <!-- cluster runtime pins — keep in sync with iceberg/argo/maintenance-workflow.yaml -->
    <spark.version>4.0.3</spark.version>
    <scala.binary.version>2.13</scala.binary.version>
    <iceberg.version>1.10.2</iceberg.version>
    <!-- exactly the AWS SDK BOM Iceberg 1.10.2 is built against — bump only together with Iceberg -->
    <awssdk.version>2.33.0</awssdk.version>
    <!-- what Spark 4.0.3 ships -->
    <jackson.version>2.18.6</jackson.version>
    <!-- Hadoop shipped by the apache/spark:4.0.3 image — hadoop-aws in the
         runner-image module must match this exactly -->
    <hadoop.version>3.4.1</hadoop.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- single place that decides every software.amazon.awssdk:* version -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-sql_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>org.apache.iceberg</groupId>
        <artifactId>iceberg-spark-runtime-4.0_${scala.binary.version}</artifactId>
        <version>${iceberg.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- guard: if some library drags Jackson in transitively, force Spark's version -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- baseline every job module inherits — no versions needed in child POMs -->
  <dependencies>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-spark-runtime-4.0_${scala.binary.version}</artifactId>
    </dependency>

    <!-- plain S3 access from application code (outside Spark).
         Version governed by the BOM; compiled into the job jar.
         This is the slim alternative to the full aws bundle. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- job modules opt in by declaring this plugin (no config needed) -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
          <executions>
            <execution>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <transformers>
                  <!-- AWS SDK and Iceberg discover implementations via service files -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                </transformers>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>ban-conflict-sources</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- AWS SDK v1 — clashes with the v2 stack Iceberg S3FileIO uses -->
                    <exclude>com.amazonaws:*</exclude>
                    <!-- fat bundles bypass the BOM; use individual awssdk modules -->
                    <exclude>software.amazon.awssdk:bundle</exclude>
                    <exclude>org.apache.iceberg:iceberg-aws-bundle</exclude>
                    <!-- S3A support belongs in the runner image (matched to its
                         Hadoop version), never in job jars. Also drags in SDK v1
                         (Hadoop <=3.3) or the v2 fat bundle (Hadoop 3.4+).
                         Iceberg table I/O doesn't need it: S3FileIO handles
                         s3://, s3a:// and s3n:// URIs itself. -->
                    <exclude>org.apache.hadoop:hadoop-aws</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
